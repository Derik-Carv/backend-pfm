# Servidor
NODE_ENV=development
PORT=3336
HOST=0.0.0.0

# CORS (em desenvolvimento aceita "*", em produção defina URLs separadas por vírgula se necessário)
CORS_ORIGIN="*"

# Credenciais do PostgreSQL
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=dev_db
POSTGRES_PORT=5432
# URL de conexão do Drizzle
DATABASE_URL="postgres://root:rootpassword@postgres:5432/dev_db"

# Autenticação e Segurança
JWT_SECRET=change-me-to-a-secure-random-secret
ADMIN_DEFAULT_PASSWORD=change-me-to-a-secure-admin-password
# CPF fictício do administrador inicial (usado apenas no seed)
CPFADMIN=00000000000
DEMO_SEED_PASSWORD=Demo@123456

# Observabilidade e Logs (Axiom / Pino)
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
AXIOM_TOKEN=
AXIOM_DATASET=backend-pfm

# SMTP AND EMAILS SETTINGS
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password