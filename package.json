{
    "name": "backend",
    "module": "src/server.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/server.ts",
        "dc": "docker compose up --build",
        "dcreset": "docker compose down && docker compose up --build",
        "start": "bun run src/server.ts",
        "build": "bun build ./src/server.ts --outdir ./dist --target bun",
        "typecheck": "tsc --noEmit",
        "preview": "bun run dist/server.js",
        "db:generate": "docker exec -it bun_backend_dev bunx drizzle-kit generate --config=drizzle.config.ts",
        "db:push": "docker exec -it bun_backend_dev bunx drizzle-kit push --config=drizzle.config.ts",
        "db:studio": "docker exec -it bun_backend_dev bunx drizzle-kit studio --config=drizzle.config.ts --host 0.0.0.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^26.5.0",
        "drizzle-kit": "^0.31.10",
        "typescript": "^5.7.0"
    },
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/jwt": "^10.2.2",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.12.3",
        "fastify-plugin": "^6.0.0",
        "pino-pretty": "^13.1.3",
        "postgres": "^3.4.9"
    }
}
