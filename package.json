{
    "name": "backend",
    "module": "src/server.ts",
    "type": "module",
    "private": true,
    "author": "Derik-Carv (https://github.com/Derik-Carv)",
    "scripts": {
        "dev": "bun --watch src/server.ts",
        "dc": "docker compose up --build",
        "dc:prod": "docker compose -f compose.yaml -f compose.production.yaml up -d --build",
        "dcreset": "docker compose down && docker compose up --build",
        "start": "bun run src/server.ts",
        "build": "bun build ./src/server.ts --outdir ./dist --target bun",
        "typecheck": "tsc --noEmit",
        "preview": "bun run dist/server.js",
        "update": "docker exec bun_backend_dev bun update",
        "security:update": "docker exec bun_backend_dev sh -c 'bun audit fix --latest && bun audit'",
        "db:generate": "docker exec bun_backend_dev bunx drizzle-kit generate --config=drizzle.config.ts",
        "db:push": "docker exec bun_backend_dev bunx drizzle-kit push --config=drizzle.config.ts",
        "db:studio": "docker exec bun_backend_dev bunx drizzle-kit studio --config=drizzle.config.ts --host 0.0.0.0",
        "db:seed": "docker exec bun_backend_dev bun run src/database/seed.ts",
        "db-reset-and-seed": "docker compose down -v && docker compose up -d --build"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^26.6.6",
        "drizzle-kit": "^0.31.11",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@axiomhq/pino": "^2.0.0",
        "@fastify/cors": "^11.3.1",
        "@fastify/helmet": "^13.2.0",
        "@fastify/jwt": "^10.2.6",
        "@fastify/multipart": "^10.1.6",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/swagger": "^9.9.2",
        "@fastify/swagger-ui": "^6.1.2",
        "@logtail/node": "^0.5.12",
        "@logtail/pino": "^0.5.12",
        "@types/uuid": "^11.0.0",
        "backend": ".",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.7",
        "fastify-plugin": "^6.0.1",
        "fastify-type-provider-zod": "^7.0.0",
        "form-auto-content": "^3.2.1",
        "nodemailer": "^10.3.1",
        "pdfjs-dist": "^6.4.299",
        "pino-pretty": "^13.2.0",
        "postgres": "^3.4.9",
        "tap": "^21.8.0",
        "uuid": "^14.0.3",
        "zod": "^4.6.7"
    }
}
